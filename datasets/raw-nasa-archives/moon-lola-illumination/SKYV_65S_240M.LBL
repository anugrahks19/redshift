PDS_VERSION_ID            = "PDS3"
PRODUCT_VERSION_ID        = "V1.05"
DATA_SET_ID               = "LRO-L-LOLA-4-GDR-V1.0"
PRODUCT_ID                = "SKYV_65S_240M"
INSTRUMENT_HOST_NAME      = "LUNAR RECONNAISSANCE ORBITER"
INSTRUMENT_NAME           = "LUNAR ORBITER LASER ALTIMETER"
INSTRUMENT_ID             = "LOLA"
MISSION_PHASE_NAME        = {"COMMISSIONING","NOMINAL MISSION","SCIENCE
                              MISSION","EXTENDED SCIENCE MISSION"}
TARGET_NAME               = MOON
START_TIME                = 2009-07-13T17:33:17.246
STOP_TIME                 = 2013-07-18T14:12:13
PRODUCT_CREATION_TIME     = 2014-06-09T00:00:00
PRODUCER_ID               = LRO_LOLA_TEAM
PRODUCER_FULL_NAME        = "DAVID E. SMITH"
PRODUCER_INSTITUTION_NAME = "GODDARD SPACE FLIGHT CENTER"
DESCRIPTION               = "This data product is a map of the solid angle
   of the sky visible from the lunar surface, i.e. the sky visibility. This
   can be useful to calibrate incoming flux calculations (e.g. cosmic rays,
   impactors). The map resolution is 240m/pix by 240m/pix, true at the
   pole in polar stereographic (spherical) projection. The calculations are 
   based on LOLA topographic data and are described in [MAZARICOETAL2011]. 
   The solid angle values are given in steradians.

   This label describes an IMG file in the form of a binary resampling with
   pixel registration.  "

OBJECT                    = UNCOMPRESSED_FILE
FILE_NAME                 = "SKYV_65S_240M.IMG"
RECORD_TYPE               = FIXED_LENGTH
FILE_RECORDS              = 6420
RECORD_BYTES              = 12840
^IMAGE                    = "SKYV_65S_240M.IMG"


  OBJECT                  = IMAGE
    NAME                  = SOLID_ANGLE
    DESCRIPTION           = "Each sample represents the solid angle of the sky
      visible from that location on the lunar surface. It is given in unit of
      steradians. In principle, it can vary between 0 (completely obscured)
      to 4*pi (no obstacle). In practice, the expected mean value is 2*pi,
      i.e. a half-plane sky visibility (above a flat surface)."
    LINES                 = 6420
    LINE_SAMPLES          = 6420
    DERIVED_MINIMUM       = 0.00339
    DERIVED_MAXIMUM       = 6.787
    SAMPLE_TYPE           = LSB_INTEGER
    SAMPLE_BITS           = 16
    UNIT                  = STERADIAN
    SCALING_FACTOR        = 0.0002
    OFFSET                = 6.2832

/* NOTE:                                                                   */
/* The conversion from Digital Number to SOLID_ANGLE in steradians is:     */
/* SOLID_ANGLE = (DN * SCALING_FACTOR) + OFFSET                            */

  END_OBJECT              = IMAGE
END_OBJECT                = UNCOMPRESSED_FILE

OBJECT                    = IMAGE_MAP_PROJECTION
 ^DATA_SET_MAP_PROJECTION     = "DSMAP_POLAR.CAT"
 MAP_PROJECTION_TYPE          = "POLAR STEREOGRAPHIC"
 KEYWORD_LATITUDE_TYPE        = "PLANETOCENTRIC"
 MAP_RESOLUTION               = 126.347 <pix/deg>
 A_AXIS_RADIUS                = 1737.4 <km>
 B_AXIS_RADIUS                = 1737.4 <km>
 C_AXIS_RADIUS                = 1737.4 <km>
 FIRST_STANDARD_PARALLEL      = 'N/A'
 SECOND_STANDARD_PARALLEL     = 'N/A'
 POSITIVE_LONGITUDE_DIRECTION = "EAST"
 CENTER_LATITUDE              = -90 <deg>
 CENTER_LONGITUDE             = 0 <deg>
 REFERENCE_LATITUDE           = 'N/A'
 REFERENCE_LONGITUDE          = 'N/A'
 LINE_FIRST_PIXEL             = 1
 LINE_LAST_PIXEL              = 6420
 SAMPLE_FIRST_PIXEL           = 1
 SAMPLE_LAST_PIXEL            = 6420
 MAP_PROJECTION_ROTATION      = 0.0
 MAP_SCALE                    = 240 <m/pix>
 MAXIMUM_LATITUDE             = -55.2 <deg>
 MINIMUM_LATITUDE             = -90 <deg>
 WESTERNMOST_LONGITUDE        = 'N/A'
 EASTERNMOST_LONGITUDE        = 'N/A'
 LINE_PROJECTION_OFFSET       = 3209.5 <pix>
 SAMPLE_PROJECTION_OFFSET     = 3209.5 <pix>
 COORDINATE_SYSTEM_TYPE       = "BODY-FIXED ROTATING"
 COORDINATE_SYSTEM_NAME       = "MEAN EARTH/POLAR AXIS OF DE421"
END_OBJECT                    = IMAGE_MAP_PROJECTION

END

